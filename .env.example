# ── Required ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Base URL of your self-hosted TREK instance, without a trailing slash
TREK_URL=https://trek.example.com
# Dedicated service account: not a personal account, no 2FA. Add it to a trip in TREK
# when the trip starts and remove it when it ends: the trips it is on are the trips the
# bot offers (/trip), so its reach is exactly what you have granted it.
TREK_EMAIL=noccounting@example.com
TREK_PASSWORD=your_trek_password
# A trip's own currency is the base its figures are reported in and its rates are stored
# against. It must be TWD or JPY; a trip in any other currency is left out of the list.

# ── Webapp ───────────────────────────────────────────────────────────────────
PORT=8080
# Set to "true" to skip Telegram initData validation (local development only)
DEV_MODE=false

# ── Bot ──────────────────────────────────────────────────────────────────────
# Mini App URL attached to the bot menu button
WEBAPP_URL=https://your-webapp-url.com
POLLER=long
WEBHOOK_PUBLIC_URL=https://your-webapp-url.com/telegram/<random>
WEBHOOK_SECRET_TOKEN=
WEBHOOK_LISTEN=:8081
# Comma-separated list: telegram_id:trek_user_id:nickname
#   The middle field is a numeric TREK user id; a non-numeric one is refused at startup.
#   Optional: leave it blank and the bot starts with nobody authorized.
USER_MAPPING=123456789:42:Alice,987654321:43:Bob

# ── Logging ──────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ── Receipt scanning (optional) ──────────────────────────────────────────────
# OpenAI-compatible vision endpoint; leave blank to disable
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o
