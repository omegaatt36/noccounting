package components

import (
	"fmt"
	"math"
	"strconv"
	"github.com/omegaatt36/noccounting/domain"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/card"
)

type CategoryBar struct {
	Slug       string
	Emoji      string
	Label      string
	Amount     string
	Percentage int
}

type MethodBar struct {
	Slug       string
	Emoji      string
	Label      string
	Amount     string
	Percentage int
}

type DateBar struct {
	Date       string
	Amount     string
	Percentage int
}

type PayerBar struct {
	Name       string
	Amount     string
	Percentage int
}

type ExpenseItem struct {
	ID            string
	TripID        int64
	Name          string
	Date          string
	AmountDisplay string
}

// BalanceRow is one person's position in the trip: Owed when they are due money.
type BalanceRow struct {
	Name   string
	Amount string
	Owed   bool
}

// TransferRow is one payment that helps settle the trip.
type TransferRow struct {
	From   string
	To     string
	Amount string
}

// SettlementView is where the trip's money stands. Unconverted counts what was
// left out because no rate could convert it.
type SettlementView struct {
	Balances    []BalanceRow
	Transfers   []TransferRow
	Unconverted int
}

// DashboardView is everything the dashboard shows, with the amounts already
// written in the trip's currency.
type DashboardView struct {
	TripTitle           string
	GrandTotal          string
	GrandTotalConverted string
	ItemCount           int
	TrendPct      int
	DonutGradient string
	Categories    []CategoryBar
	Methods       []MethodBar
	Dates         []DateBar
	Payers        []PayerBar
	// Settlement is nil when TREK could not be asked, which leaves its card out.
	Settlement *SettlementView
	DateRange  string
}

// dashboardRanges are the periods the dashboard can be drawn for, in the order
// of the chips that pick them.
var dashboardRanges = []struct{ Value, Label string }{
	{"today", "今天"},
	{"3d", "近3天"},
	{"7d", "近7天"},
	{"all", "全部"},
}

// rangeActive says whether the chip for value is the one showing: a dashboard
// asked for no range shows them all.
func rangeActive(selected, value string) bool {
	if selected == "" {
		selected = "all"
	}
	return selected == value
}

// categoryColors maps a category to its hex color, in the Flexoki palette: each
// of TREK's fourteen has a color of its own so no two read as the same on the donut.
var categoryColors = map[domain.Category]string{
	domain.CategoryFood:          "#D0A215",
	domain.CategoryTransport:     "#4385BE",
	domain.CategoryShopping:      "#CE5D97",
	domain.CategoryActivities:    "#879A39",
	domain.CategoryAccommodation: "#3AA99F",
	domain.CategorySightseeing:   "#8B7EC8",
	domain.CategoryGroceries:     "#DA702C",
	domain.CategoryFlights:       "#205EA6",
	domain.CategoryFuel:          "#D14D41",
	domain.CategoryParking:       "#5E409D",
	domain.CategoryFees:          "#AF3029",
	domain.CategoryHealth:        "#66800B",
	domain.CategoryTips:          "#AD8301",
	domain.CategoryOther:         "#6F6E69",
}

// CategoryColor is the color of a category slug, or the neutral gray for
// anything that is not one.
func CategoryColor(slug string) string {
	if color, ok := categoryColors[domain.Category(slug)]; ok {
		return color
	}
	return "#575653"
}

templ DashboardContent(v DashboardView) {
	<div id="dashboard-content" class="space-y-6 pb-6">
		<p class="text-center text-xs text-muted-foreground">🧳 { v.TripTitle }</p>
		<div class="flex gap-2 justify-center flex-wrap" role="group" aria-label="期間">
			for _, r := range dashboardRanges {
				<button
					type="button"
					data-range={ r.Value }
					data-dashboard-load
					aria-pressed={ strconv.FormatBool(rangeActive(v.DateRange, r.Value)) }
					class={ templ.KV("bg-primary text-primary-foreground", rangeActive(v.DateRange, r.Value)), templ.KV("bg-muted text-muted-foreground", !rangeActive(v.DateRange, r.Value)), "px-4 py-2 rounded text-sm font-medium transition-colors" }
					hx-get={ "/partial/dashboard?range=" + r.Value }
					hx-target="#dashboard-host"
					hx-swap="innerHTML"
				>
					{ r.Label }
				</button>
			}
		</div>
		@card.Card() {
			<div class="p-4">
				<div class="flex items-center gap-4 py-2">
					<div class="relative w-24 h-24 flex-shrink-0" aria-hidden="true">
						<div
							class="w-24 h-24 rounded-full"
							style={ fmt.Sprintf("background: %s", v.DonutGradient) }
						></div>
						<div class="absolute inset-0 m-auto w-14 h-14 rounded-full bg-card"></div>
					</div>
					<div class="flex-1 min-w-0">
						<p class="text-xs text-muted-foreground mb-1 tracking-widest uppercase">總消費</p>
						<p class="text-3xl font-bold text-primary leading-none mb-1 tracking-tight">
							{ v.GrandTotal }
						</p>
						if v.GrandTotalConverted != "" {
							<p class="text-xs font-semibold text-muted-foreground/80 mb-2">
								{ v.GrandTotalConverted }
							</p>
						}
						<div class="flex items-center gap-2 flex-wrap">
							<span class="text-xs text-muted-foreground">{ fmt.Sprintf("%d 筆", v.ItemCount) }</span>
							if v.TrendPct != 0 {
								<span class={
									templ.KV("text-xs font-semibold px-1.5 py-0.5 rounded", true),
									templ.KV("bg-red-500/15 text-red-700 dark:text-red-400", v.TrendPct > 0),
									templ.KV("bg-green-500/15 text-green-800 dark:text-green-400", v.TrendPct < 0),
								}>
									if v.TrendPct > 0 {
										{ "↑" }
									} else {
										{ "↓" }
									}
									{ fmt.Sprintf("%d%% vs 上期", int(math.Abs(float64(v.TrendPct)))) }
								</span>
							}
						</div>
					</div>
				</div>
				<div class="flex flex-wrap gap-x-3 gap-y-1 pt-3 mt-2 border-t border-border">
					for _, cat := range v.Categories {
						if cat.Percentage == 0 {
							continue
						}
						<div class="flex items-center gap-1.5 text-xs text-muted-foreground">
							<span
								class="w-2 h-2 rounded-sm inline-block"
								style={ fmt.Sprintf("background: %s", CategoryColor(cat.Slug)) }
							></span>
							{ cat.Emoji } { cat.Label }
						</div>
					}
				</div>
			</div>
		}
		if v.Settlement != nil {
			@settlementCard(v.Settlement)
		}
		if len(v.Categories) == 0 {
			<div class="text-center py-12">
				<p class="text-lg text-muted-foreground"><span aria-hidden="true">📊</span> 這個期間沒有消費記錄</p>
				<button
					type="button"
					data-action="show-form"
					class="mt-4 px-4 py-2 rounded text-sm font-medium bg-primary text-primary-foreground"
				>
					去記一筆
				</button>
			</div>
		} else {
			<div class="space-y-3">
				<h3 class="text-lg font-semibold text-foreground">分類明細</h3>
				for _, cat := range v.Categories {
					if cat.Percentage == 0 {
						continue
					}
					<div>
						<button
							type="button"
							class="w-full text-left cursor-pointer flex items-center gap-3 py-1 hover:bg-muted/50 rounded transition-colors"
							data-detail={ fmt.Sprintf("cat-detail-%s", cat.Slug) }
							aria-expanded="false"
							aria-controls={ fmt.Sprintf("cat-detail-%s", cat.Slug) }
							hx-get={ fmt.Sprintf("/partial/dashboard/category?name=%s&range=%s", cat.Slug, v.DateRange) }
							hx-target={ fmt.Sprintf("#cat-detail-%s", cat.Slug) }
							hx-swap="innerHTML"
						>
							<span class="w-8 text-center" aria-hidden="true">{ cat.Emoji }</span>
							<span class="w-20 text-sm text-muted-foreground">{ cat.Label }</span>
							<span class="flex-1 bg-secondary rounded-full overflow-hidden h-6" aria-hidden="true">
								<span
									class="block h-6 transition-all"
									style={ fmt.Sprintf("width: %d%%; background: %s;", cat.Percentage, CategoryColor(cat.Slug)) }
								></span>
							</span>
							<span class="w-20 text-right text-sm font-medium tabular-nums">{ cat.Amount }</span>
							<span class="w-10 text-right text-xs text-muted-foreground tabular-nums">{ fmt.Sprintf("%d%%", cat.Percentage) }</span>
							<span class="chevron text-xs text-muted-foreground w-4 text-center" aria-hidden="true">▶</span>
						</button>
						<div id={ fmt.Sprintf("cat-detail-%s", cat.Slug) } class="pl-8 mt-1 empty:hidden" role="region" aria-label={ cat.Label + "明細" }></div>
					</div>
				}
			</div>
			<div class="space-y-3">
				<h3 class="text-lg font-semibold text-foreground">付款方式明細</h3>
				for _, method := range v.Methods {
					<div>
						<button
							type="button"
							class="w-full text-left cursor-pointer flex items-center gap-3 py-1 hover:bg-muted/50 rounded transition-colors"
							data-detail={ "method-detail-" + methodKey(method.Slug) }
							aria-expanded="false"
							aria-controls={ "method-detail-" + methodKey(method.Slug) }
							hx-get={ fmt.Sprintf("/partial/dashboard/method?name=%s&range=%s", method.Slug, v.DateRange) }
							hx-target={ "#method-detail-" + methodKey(method.Slug) }
							hx-swap="innerHTML"
						>
							<span class="w-8 text-center" aria-hidden="true">{ method.Emoji }</span>
							<span class="w-20 text-sm text-muted-foreground">{ method.Label }</span>
							<span class="flex-1 bg-secondary rounded-full overflow-hidden h-6" aria-hidden="true">
								<span
									class="block bg-accent h-6 transition-all"
									style={ fmt.Sprintf("width: %d%%", method.Percentage) }
								></span>
							</span>
							<span class="w-20 text-right text-sm font-medium tabular-nums">{ method.Amount }</span>
							<span class="w-10 text-right text-xs text-muted-foreground tabular-nums">{ fmt.Sprintf("%d%%", method.Percentage) }</span>
							<span class="chevron text-xs text-muted-foreground w-4 text-center" aria-hidden="true">▶</span>
						</button>
						<div id={ "method-detail-" + methodKey(method.Slug) } class="pl-8 mt-1 empty:hidden" role="region" aria-label={ method.Label + "明細" }></div>
					</div>
				}
			</div>
			<div class="space-y-3">
				<h3 class="text-lg font-semibold text-foreground">日期明細</h3>
				for _, d := range v.Dates {
					<div class="flex items-center gap-3">
						<div class="w-12 text-sm text-muted-foreground">{ d.Date }</div>
						<div class="flex-1 bg-secondary rounded-full overflow-hidden h-6">
							<div
								class="bg-accent h-6 transition-all"
								style={ fmt.Sprintf("width: %d%%", d.Percentage) }
							></div>
						</div>
						<div class="w-20 text-right text-sm font-medium tabular-nums">{ d.Amount }</div>
					</div>
				}
			</div>
			<div class="space-y-3">
				<h3 class="text-lg font-semibold text-foreground">付款人明細</h3>
				for _, payer := range v.Payers {
					<div class="flex items-center justify-between">
						<div class="text-sm font-medium">{ payer.Name }</div>
						<div class="text-right">
							<div class="text-sm font-medium tabular-nums">{ payer.Amount }</div>
							<div class="text-xs text-muted-foreground tabular-nums">{ fmt.Sprintf("%d%%", payer.Percentage) }</div>
						</div>
					</div>
				}
			</div>
			<div class="flex justify-center pt-4">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/api/export/csv?range=%s", v.DateRange)) }
					download
					class="px-4 py-2 rounded font-medium text-sm bg-muted text-muted-foreground hover:bg-muted/80 transition-colors"
				>
					<span aria-hidden="true">📥</span> 導出 CSV
				</a>
			</div>
		}
	</div>
}

// methodKey is the part of an element id that names a payment method; the
// expenses that record none have no slug to name them by.
func methodKey(slug string) string {
	if slug == "" {
		return "none"
	}
	return slug
}

templ settlementCard(settlement *SettlementView) {
	@card.Card() {
		<div class="p-4 space-y-3">
			<h3 class="text-lg font-semibold text-foreground">💸 結算</h3>
			if len(settlement.Balances) == 0 {
				<p class="text-sm text-muted-foreground">🎉 目前沒有任何人欠款</p>
			} else {
				<div class="space-y-1">
					for _, balance := range settlement.Balances {
						<div class="flex items-center justify-between text-sm">
							<span>{ balance.Name }</span>
							<span
								class={ "font-medium tabular-nums", templ.KV("text-green-800 dark:text-green-400", balance.Owed), templ.KV("text-red-700 dark:text-red-400", !balance.Owed) }
							>
								{ balance.Amount }
							</span>
						</div>
					}
				</div>
				if len(settlement.Transfers) > 0 {
					<div class="pt-2 border-t border-border space-y-1">
						<p class="text-xs text-muted-foreground">建議轉帳</p>
						for _, transfer := range settlement.Transfers {
							<div class="flex items-center justify-between text-sm">
								<span>{ transfer.From } → { transfer.To }</span>
								<span class="font-medium tabular-nums">{ transfer.Amount }</span>
							</div>
						}
					</div>
				}
			}
			if settlement.Unconverted > 0 {
				<p class="text-xs text-muted-foreground">{ fmt.Sprintf("⚠️ 有 %d 筆因為缺少匯率沒有計入", settlement.Unconverted) }</p>
			}
		</div>
	}
}

templ CategoryDetailPartial(items []ExpenseItem, color string) {
	<div class="border-l-2 pl-3 space-y-0.5 mb-2" style={ fmt.Sprintf("border-color: %s", color) }>
		for _, item := range items {
			<div class="expense-row flex items-center py-1.5 border-b border-border/50 text-sm group">
				<span class="flex-1 text-muted-foreground truncate">{ item.Name }</span>
				<span class="text-xs text-muted-foreground mr-3">{ item.Date }</span>
				<span class="font-medium whitespace-nowrap">{ item.AmountDisplay }</span>
				<button
					type="button"
					class="ml-1 inline-flex items-center justify-center size-9 text-muted-foreground hover:text-destructive transition-colors text-xs opacity-60 hover:opacity-100"
					hx-delete={ fmt.Sprintf("/api/expense?id=%s&trip_id=%d", item.ID, item.TripID) }
					hx-confirm="確定要刪除這筆消費嗎？"
					hx-target="closest .expense-row"
					hx-swap="outerHTML"
					aria-label={ "刪除 " + item.Name }
				>
					<span aria-hidden="true">🗑️</span>
				</button>
			</div>
		}
	</div>
}
