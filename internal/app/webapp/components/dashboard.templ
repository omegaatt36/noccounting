package components

import (
	"fmt"
	"github.com/omegaatt36/noccounting/domain"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/card"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/icon"
	"math"
	"strconv"
)

type CategoryBar struct {
	Slug       string
	Emoji      string
	Label      string
	Amount     string
	Percentage int
}

type MethodBar struct {
	Slug       string
	Emoji      string
	Label      string
	Amount     string
	Percentage int
}

type DateBar struct {
	Date       string
	ISODate    string
	Amount     string
	Percentage int
}

type PayerBar struct {
	ID         string
	Name       string
	Amount     string
	Percentage int
}

type DashboardView struct {
	TripTitle           string
	GrandTotal          string
	GrandTotalConverted string
	ItemCount           int
	TrendPct            int
	DonutGradient       string
	Categories          []CategoryBar
	Methods             []MethodBar
	Dates               []DateBar
	Payers              []PayerBar
	DateRange           string
}

var dashboardRanges = []struct{ Value, Label string }{
	{"today", "今天"},
	{"3d", "近3天"},
	{"7d", "近7天"},
	{"all", "全部"},
}

func rangeActive(selected, value string) bool {
	if selected == "" {
		selected = "all"
	}
	return selected == value
}

// categoryColors is in the Flexoki palette; each of TREK's fourteen categories has a color of its own so no two read as the same on the donut.
var categoryColors = map[domain.Category]string{
	domain.CategoryFood:          "#D0A215",
	domain.CategoryTransport:     "#4385BE",
	domain.CategoryShopping:      "#CE5D97",
	domain.CategoryActivities:    "#879A39",
	domain.CategoryAccommodation: "#3AA99F",
	domain.CategorySightseeing:   "#8B7EC8",
	domain.CategoryGroceries:     "#DA702C",
	domain.CategoryFlights:       "#205EA6",
	domain.CategoryFuel:          "#D14D41",
	domain.CategoryParking:       "#5E409D",
	domain.CategoryFees:          "#AF3029",
	domain.CategoryHealth:        "#66800B",
	domain.CategoryTips:          "#AD8301",
	domain.CategoryOther:         "#6F6E69",
}

// percentLabel shows a share too small to round to 1% as "<1%", never "0%" beside a nonzero amount.
func percentLabel(percentage int) string {
	if percentage < 1 {
		return "<1%"
	}
	return fmt.Sprintf("%d%%", percentage)
}

// barWidth keeps the smallest share a sliver, not nothing.
func barWidth(percentage int) int {
	return max(percentage, 1)
}

// CategoryColor is the neutral gray for anything that is not a category slug.
func CategoryColor(slug string) string {
	if color, ok := categoryColors[domain.Category(slug)]; ok {
		return color
	}
	return "#575653"
}

templ DashboardContent(v DashboardView) {
	<div id="dashboard-content" class="space-y-6 pb-6" data-range={ v.DateRange }>
		<p class="flex items-center justify-center gap-1.5 text-xs text-muted-foreground">
			<span aria-hidden="true" class="inline-flex">@icon.Luggage(icon.Props{Size: 14})
</span>
			{ v.TripTitle }
		</p>
		<div class="flex gap-2 justify-center flex-wrap" role="group" aria-label="期間">
			for _, r := range dashboardRanges {
				<button
					type="button"
					data-range={ r.Value }
					data-view-source="stats"
					aria-pressed={ strconv.FormatBool(rangeActive(v.DateRange, r.Value)) }
					class={ templ.KV("bg-primary text-primary-foreground", rangeActive(v.DateRange, r.Value)), templ.KV("bg-muted text-muted-foreground", !rangeActive(v.DateRange, r.Value)), "px-4 py-2 rounded text-sm font-medium transition-colors" }
					hx-get={ "/partial/dashboard?range=" + r.Value }
					hx-target="#stats-host"
					hx-swap="innerHTML"
				>
					{ r.Label }
				</button>
			}
		</div>
		@card.Card() {
			<div class="p-4">
				<div class="flex items-center gap-4 py-2">
					<div class="relative w-24 h-24 flex-shrink-0" aria-hidden="true">
						<div
							class="w-24 h-24 rounded-full"
							style={ fmt.Sprintf("background: %s", v.DonutGradient) }
						></div>
						<div class="absolute inset-0 m-auto w-14 h-14 rounded-full bg-card"></div>
					</div>
					<div class="flex-1 min-w-0">
						<p class="text-xs text-muted-foreground mb-1 tracking-widest uppercase">總消費</p>
						<p class="text-3xl font-bold text-primary leading-none mb-1 tracking-tight">
							{ v.GrandTotal }
						</p>
						if v.GrandTotalConverted != "" {
							<p class="text-xs font-semibold text-muted-foreground/80 mb-2">
								{ v.GrandTotalConverted }
							</p>
						}
						<div class="flex items-center gap-2 flex-wrap">
							<span class="text-xs text-muted-foreground">{ fmt.Sprintf("%d 筆", v.ItemCount) }</span>
							if v.TrendPct != 0 {
								<span
									class={
										templ.KV("text-xs font-semibold px-1.5 py-0.5 rounded", true),
										templ.KV("bg-red-500/15 text-red-700 dark:text-red-400", v.TrendPct > 0),
										templ.KV("bg-green-500/15 text-green-800 dark:text-green-400", v.TrendPct < 0),
									}
								>
									if v.TrendPct > 0 {
										{ "↑" }
									} else {
										{ "↓" }
									}
									{ fmt.Sprintf("%d%% vs 上期", int(math.Abs(float64(v.TrendPct)))) }
								</span>
							}
						</div>
					</div>
				</div>
				<div class="flex flex-wrap gap-x-3 gap-y-1 pt-3 mt-2 border-t border-border">
					for _, cat := range v.Categories {
						<div class="flex items-center gap-1.5 text-xs text-muted-foreground">
							<span
								class="w-2 h-2 rounded-sm inline-block"
								style={ fmt.Sprintf("background: %s", CategoryColor(cat.Slug)) }
							></span>
							{ cat.Emoji } { cat.Label }
						</div>
					}
				</div>
			</div>
		}
		if len(v.Categories) == 0 {
			<div class="text-center py-12">
				<p class="flex items-center justify-center gap-2 text-lg text-muted-foreground">
					<span aria-hidden="true" class="inline-flex">@icon.ChartPie(icon.Props{Size: 22})
</span>
					這個期間沒有消費記錄
				</p>
				<button
					type="button"
					data-action="show-form"
					class="mt-4 px-4 py-2 rounded text-sm font-medium bg-primary text-primary-foreground"
				>
					去記一筆
				</button>
			</div>
		} else {
			<div class="space-y-3">
				<h2 class="text-lg font-semibold text-foreground">分類明細</h2>
				for _, cat := range v.Categories {
					<button
						type="button"
						class="w-full text-left cursor-pointer flex items-center gap-2 py-1.5 hover:bg-muted/50 rounded transition-colors"
						data-list-category={ cat.Slug }
						aria-label={ cat.Label + "，查看明細" }
					>
						<span class="flex-1 min-w-0">
							@breakdownBody(cat.Emoji, cat.Label, cat.Amount, cat.Percentage, CategoryColor(cat.Slug))
						</span>
						<span aria-hidden="true" class="inline-flex text-muted-foreground">@icon.ChevronRight(icon.Props{Size: 14})</span>
					</button>
				}
			</div>
			<div class="space-y-3">
				<h2 class="text-lg font-semibold text-foreground">付款方式明細</h2>
				for _, method := range v.Methods {
					@methodRow(method)
				}
			</div>
			<div class="space-y-3">
				<h2 class="text-lg font-semibold text-foreground">日期明細</h2>
				for _, d := range v.Dates {
					@dateRow(d)
				}
			</div>
			<div class="space-y-3">
				<h2 class="text-lg font-semibold text-foreground">付款人明細</h2>
				for _, payer := range v.Payers {
					@payerRow(payer)
				}
			</div>
			<div class="flex justify-center pt-4">
				<a
					href={ templ.SafeURL(fmt.Sprintf("/api/export/csv?range=%s", v.DateRange)) }
					download
					class="inline-flex items-center gap-2 px-4 py-2 rounded font-medium text-sm bg-muted text-muted-foreground hover:bg-muted/80 transition-colors"
				>
					<span aria-hidden="true" class="inline-flex">@icon.Download(icon.Props{Size: 16})
</span>
					匯出 CSV
				</a>
			</div>
		}
	</div>
}

templ breakdownBody(emoji string, label string, amount string, percentage int, color string) {
	<span class="flex items-center gap-2">
		<span class="w-6 text-center" aria-hidden="true">{ emoji }</span>
		<span class="flex-1 min-w-0 truncate text-sm text-muted-foreground">{ label }</span>
		<span class="text-sm font-medium tabular-nums">{ amount }</span>
		<span class="w-10 text-right text-xs text-muted-foreground tabular-nums">{ percentLabel(percentage) }</span>
	</span>
	<span class="mt-1.5 block h-2 rounded-full bg-secondary overflow-hidden" aria-hidden="true">
		<span class="block h-2 rounded-full transition-all" style={ fmt.Sprintf("width: %d%%; background: %s;", barWidth(percentage), color) }></span>
	</span>
}

// methodRow opens its expenses, except for those that record no method, which the list has no filter for.
templ methodRow(method MethodBar) {
	if method.Slug == "" {
		<div class="w-full flex items-center gap-2 py-1.5">
			<span class="flex-1 min-w-0">
				@breakdownBody(method.Emoji, method.Label, method.Amount, method.Percentage, "var(--color-accent)")
			</span>
			<span class="inline-block w-3.5"></span>
		</div>
	} else {
		<button
			type="button"
			class="w-full text-left cursor-pointer flex items-center gap-2 py-1.5 hover:bg-muted/50 rounded transition-colors"
			data-list-method={ method.Slug }
			aria-label={ method.Label + "，查看明細" }
		>
			<span class="flex-1 min-w-0">
				@breakdownBody(method.Emoji, method.Label, method.Amount, method.Percentage, "var(--color-accent)")
			</span>
			<span aria-hidden="true" class="inline-flex text-muted-foreground">@icon.ChevronRight(icon.Props{Size: 14})</span>
		</button>
	}
}

templ dateRow(d DateBar) {
	if d.ISODate == "" {
		<div class="flex items-center gap-3 py-1">
			<div class="w-12 text-sm text-muted-foreground">{ d.Date }</div>
			<div class="flex-1 bg-secondary rounded-full overflow-hidden h-6">
				<div
					class="bg-accent h-6 transition-all"
					style={ fmt.Sprintf("width: %d%%", barWidth(d.Percentage)) }
				></div>
			</div>
			<div class="w-20 text-right text-sm font-medium tabular-nums">{ d.Amount }</div>
		</div>
	} else {
		<button
			type="button"
			class="w-full text-left cursor-pointer flex items-center gap-2 py-1 hover:bg-muted/50 rounded transition-colors"
			data-list-date={ d.ISODate }
			aria-label={ d.Date + "，查看明細" }
		>
			<span class="w-12 text-sm text-muted-foreground">{ d.Date }</span>
			<span class="flex-1 bg-secondary rounded-full overflow-hidden h-6">
				<span
					class="block bg-accent h-6 transition-all"
					style={ fmt.Sprintf("width: %d%%", barWidth(d.Percentage)) }
				></span>
			</span>
			<span class="w-20 text-right text-sm font-medium tabular-nums">{ d.Amount }</span>
			<span aria-hidden="true" class="inline-flex text-muted-foreground">@icon.ChevronRight(icon.Props{Size: 14})</span>
		</button>
	}
}

templ payerRow(payer PayerBar) {
	if payer.ID == "" {
		<div class="flex items-center justify-between py-1">
			<div class="text-sm font-medium">{ payer.Name }</div>
			<div class="text-right">
				<div class="text-sm font-medium tabular-nums">{ payer.Amount }</div>
				<div class="text-xs text-muted-foreground tabular-nums">{ percentLabel(payer.Percentage) }</div>
			</div>
		</div>
	} else {
		<button
			type="button"
			class="w-full text-left cursor-pointer flex items-center justify-between gap-2 py-1.5 hover:bg-muted/50 rounded transition-colors"
			data-list-payer={ payer.ID }
			aria-label={ payer.Name + "，查看明細" }
		>
			<span class="text-sm font-medium">{ payer.Name }</span>
			<span class="flex items-center gap-2">
				<span class="text-right">
					<span class="block text-sm font-medium tabular-nums">{ payer.Amount }</span>
					<span class="block text-xs text-muted-foreground tabular-nums">{ percentLabel(payer.Percentage) }</span>
				</span>
				<span aria-hidden="true" class="inline-flex text-muted-foreground">@icon.ChevronRight(icon.Props{Size: 14})</span>
			</span>
		</button>
	}
}
