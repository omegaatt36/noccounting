package components

import (
	"github.com/omegaatt36/noccounting/domain"
	"github.com/omegaatt36/noccounting/internal/app/format"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/button"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/icon"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/input"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/label"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/tabs"
)

templ ExpenseForm() {
	<form
		id="expense-form"
		hx-post="/api/expense"
		hx-target="#result"
		hx-swap="innerHTML"
		class="space-y-4"
	>
		<input type="hidden" id="init_data" name="init_data" value=""/>
		<input type="hidden" id="trip-id-input" name="trip_id" value=""/>
		<input type="hidden" id="expense-id" name="expense_id" value=""/>
		<input type="hidden" id="receipt-url" name="receipt_url" value=""/>
		<input type="hidden" id="receipt-items" name="receipt_items" value=""/>
		<div id="edit-bar" class="hidden">
			<div class="flex items-center justify-between">
				<button
					type="button"
					data-action="cancel-edit"
					class="inline-flex items-center gap-1 px-2 py-1.5 rounded-md text-sm text-muted-foreground hover:text-foreground transition-colors"
				>
					<span aria-hidden="true" class="inline-flex">@icon.ArrowLeft(icon.Props{Size: 16})
</span>
					返回明細
				</button>
				<button
					type="button"
					data-action="delete-expense"
					class="inline-flex items-center gap-1 px-2 py-1.5 rounded-md text-sm text-destructive hover:bg-destructive/10 transition-colors"
				>
					<span aria-hidden="true" class="inline-flex">@icon.Trash2(icon.Props{Size: 16})
</span>
					刪除
				</button>
			</div>
		</div>
		<h1 class="flex items-center justify-center gap-2 text-xl font-bold py-1">
			<span aria-hidden="true" class="inline-flex">@icon.SquarePen(icon.Props{Size: 22})
</span>
			<span id="form-title">新增消費</span>
		</h1>
		<div id="receipt-row" class="flex items-center justify-between pb-1">
			<label
				for="receipt-file-input"
				class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border border-border bg-card hover:bg-muted text-foreground transition-all shadow-sm active:scale-95"
			>
				<span aria-hidden="true" class="inline-flex">@icon.Camera(icon.Props{Size: 14})
</span>
				<span>拍照 / 上傳收據辨識</span>
			</label>
			<input type="file" id="receipt-file-input" accept="image/*" class="hidden"/>
			<span id="receipt-scanning-indicator" role="status" class="hidden text-xs text-primary font-medium animate-pulse">
				<span class="inline-flex items-center gap-1.5">
					<span aria-hidden="true" class="inline-flex">@icon.ScanLine(icon.Props{Size: 14})
</span>
					正在分析收據...
				</span>
			</span>
		</div>
		<div class="grid grid-cols-5 gap-3">
			<div class="col-span-3">
				@label.Label(label.Props{For: "name"}) {
					消費名稱
				}
				@input.Input(input.Props{
					ID:          "name",
					Name:        "name",
					Type:        input.TypeText,
					Placeholder: "例：拉麵（未填預設分類）",
					Attributes:  templ.Attributes{"aria-describedby": "name-error"},
				})
				<p id="name-error" role="alert" class="hidden text-xs text-destructive mt-1">請輸入消費名稱</p>
			</div>
			<div class="col-span-2">
				@label.Label(label.Props{For: "price"}) {
					金額
				}
				@input.Input(input.Props{
					ID:          "price",
					Name:        "price",
					Type:        input.TypeText,
					Placeholder: "0",
					Attributes: templ.Attributes{
						"required":         true,
						"readonly":         true,
						"inputmode":        "none",
						"aria-haspopup":    "dialog",
						"aria-expanded":    "false",
						"aria-describedby": "price-error",
					},
					Class: "cursor-pointer",
				})
				<p id="price-error" role="alert" class="hidden text-xs text-destructive mt-1">請輸入有效金額</p>
			</div>
		</div>
		<div>
			@label.Label(label.Props{}) {
				分類
			}
			<input type="hidden" name="category" id="category-input" value={ string(domain.CategoryFood) }/>
			@tabs.Tabs(tabs.Props{ID: "category-tabs"}) {
				@tabs.List(tabs.ListProps{Class: "grid grid-cols-3 gap-1.5 w-full h-auto", Attributes: templ.Attributes{"role": "radiogroup", "aria-label": "分類"}}) {
					for i, category := range domain.CategoryValues()[:5] {
						@tabs.Trigger(tabs.TriggerProps{
							Value:      string(category),
							IsActive:   i == 0,
							Attributes: templ.Attributes{"data-category-label": format.CategoryLabel(category)},
						}) {
							{ format.Category(category) }
						}
					}
					<button
						type="button"
						id="more-categories-btn"
						aria-expanded="false"
						aria-controls="more-categories"
						class="inline-flex items-center justify-center rounded-md px-2 py-1.5 text-sm font-medium text-muted-foreground hover:text-foreground border border-dashed border-border transition-colors cursor-pointer"
					>
						更多分類 ▾
					</button>
					<div id="more-categories" class="hidden col-span-3 grid grid-cols-3 gap-1.5 w-full">
						for _, category := range domain.CategoryValues()[5:] {
							@tabs.Trigger(tabs.TriggerProps{
								Value:      string(category),
								Attributes: templ.Attributes{"data-category-label": format.CategoryLabel(category)},
							}) {
								{ format.Category(category) }
							}
						}
					</div>
				}
			}
		</div>
		<div>
			@label.Label(label.Props{}) {
				幣別
			}
			<input type="hidden" name="currency" id="currency-input" value="JPY"/>
			@tabs.Tabs(tabs.Props{ID: "currency-tabs"}) {
				@tabs.List(tabs.ListProps{Class: "flex gap-2 w-full", Attributes: templ.Attributes{"role": "radiogroup", "aria-label": "幣別"}}) {
					@tabs.Trigger(tabs.TriggerProps{Value: "JPY", IsActive: true, Class: "flex-1"}) {
						🇯🇵 JPY
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "TWD", Class: "flex-1"}) {
						🇹🇼 TWD
					}
				}
			}
			<div id="exchange-rate-section" class="overflow-hidden transition-all duration-300 ease-in-out" style="max-height: 0; opacity: 0;">
				<div class="flex items-center gap-2 mt-3">
					<label for="exchange-rate-input" class="text-sm whitespace-nowrap text-muted-foreground">匯率</label>
					@input.Input(input.Props{
						ID:   "exchange-rate-input",
						Name: "exchange_rate",
						Type: input.TypeText,
						Attributes: templ.Attributes{
							"inputmode":   "decimal",
							"placeholder": "自動",
						},
						Class: "flex-1",
					})
					@button.Button(button.Props{
						ID:         "fetch-rate-btn",
						Type:       button.TypeButton,
						Size:       button.SizeIcon,
						Attributes: templ.Attributes{"aria-label": "取得即時匯率"},
					}) {
						<span class="fetch-text" aria-hidden="true"><span class="inline-flex">@icon.RefreshCw(icon.Props{Size: 16})
</span></span>
						<span class="fetch-loading hidden" aria-hidden="true"><span class="inline-flex">@icon.LoaderCircle(icon.Props{Size: 16, Class: "animate-spin"})
</span></span>
					}
					<span id="rate-status" class="text-xs text-muted-foreground whitespace-nowrap"></span>
				</div>
				<p id="rate-hint" class="text-xs text-muted-foreground mt-1"></p>
			</div>
		</div>
		<div>
			@label.Label(label.Props{}) {
				付款方式
			}
			<input type="hidden" name="method" id="method-input" value={ string(domain.PaymentMethodCash) }/>
			@tabs.Tabs(tabs.Props{ID: "method-tabs"}) {
				@tabs.List(tabs.ListProps{Class: "grid grid-cols-2 gap-1.5 w-full h-auto", Attributes: templ.Attributes{"role": "radiogroup", "aria-label": "付款方式"}}) {
					for i, method := range domain.PaymentMethodValues() {
						@tabs.Trigger(tabs.TriggerProps{Value: string(method), IsActive: i == 0}) {
							{ format.PaymentEmoji(method) } { format.PaymentLabel(method) }
						}
					}
				}
			}
		</div>
		<div class="grid grid-cols-2 gap-3">
			<div>
				@label.Label(label.Props{For: "paid-by-select"}) {
					付款人
				}
				<select
					name="paid_by"
					id="paid-by-select"
					class="w-full px-3 py-2 rounded-md outline-none text-sm bg-input dark:bg-input/30 border border-input focus:ring-2 focus:ring-ring/50"
				></select>
			</div>
			<div>
				@label.Label(label.Props{For: "date-input"}) {
					日期
				}
				<div class="flex gap-1.5 mb-1.5 mt-1">
					<button
						type="button"
						id="date-today-btn"
						aria-pressed="true"
						class="flex-1 text-xs rounded-md border border-input bg-primary text-primary-foreground py-1 transition-colors"
					>今天</button>
					<button
						type="button"
						id="date-yesterday-btn"
						aria-pressed="false"
						class="flex-1 text-xs rounded-md border border-input bg-muted text-muted-foreground py-1 transition-colors"
					>昨天</button>
				</div>
				@input.Input(input.Props{
					ID:   "date-input",
					Name: "shopped_at",
					Type: input.TypeDate,
				})
			</div>
		</div>
		<div>
			@label.Label(label.Props{}) {
				分攤（平均分給勾選的人）
			}
			<div id="participants" role="group" aria-label="分攤的人" aria-describedby="participants-error" class="flex flex-wrap gap-1.5 mt-1"></div>
			<p id="participants-error" role="alert" class="hidden text-xs text-destructive mt-1">至少要有一位分攤的人</p>
		</div>
		@button.Button(button.Props{
			ID:        "submit-btn",
			Type:      button.TypeSubmit,
			FullWidth: true,
			Variant:   button.VariantDefault,
			Size:      button.SizeLg,
			Class:     "hidden",
		}) {
			<span class="btn-text">
				<span class="inline-flex items-center gap-2">
					<span aria-hidden="true" class="inline-flex">@icon.Check(icon.Props{Size: 18})
</span>
					<span id="submit-label">新增消費</span>
				</span>
			</span>
			<span class="btn-loading hidden">
				<span class="inline-flex items-center gap-2">
					<span aria-hidden="true" class="inline-flex">@icon.LoaderCircle(icon.Props{Size: 18, Class: "animate-spin"})
</span>
					處理中...
				</span>
			</span>
		}
		<div
			id="numpad-backdrop"
			class="hidden fixed inset-0 bg-black/60 z-40"
		></div>
		<div
			id="numpad-sheet"
			role="dialog"
			aria-modal="true"
			aria-label="輸入金額"
			class="hidden fixed bottom-0 left-0 right-0 flex-col bg-background border-t border-border rounded-t-2xl p-3 pb-8 z-50 shadow-2xl"
		>
			<div class="flex items-baseline justify-between px-1 mb-3">
				<div class="flex items-baseline gap-2">
					<span id="numpad-display" aria-live="polite" class="text-3xl font-bold tracking-tight">0</span>
					<span class="text-sm text-muted-foreground" id="numpad-currency-label">JPY</span>
				</div>
				<div class="flex items-center gap-2">
					<span id="numpad-convert" aria-live="polite" class="text-sm text-cyan-700 dark:text-cyan-400"></span>
					<button
						type="button"
						id="numpad-clear"
						class="text-sm text-muted-foreground hover:text-foreground px-2 py-1 transition-colors"
					>清除</button>
				</div>
			</div>
			<div class="grid grid-cols-3 gap-2 mb-3">
				@numpadKey("1")
				@numpadKey("2")
				@numpadKey("3")
				@numpadKey("4")
				@numpadKey("5")
				@numpadKey("6")
				@numpadKey("7")
				@numpadKey("8")
				@numpadKey("9")
				@numpadKeyLabeled("00", "兩個零")
				@numpadKey("0")
				@numpadKeyIcon("backspace", "刪除")
			</div>
			<div class="grid grid-cols-4 gap-2">
				<button
					type="button"
					data-numpad-key="+"
					aria-label="加"
					class="bg-secondary hover:bg-secondary/80 active:scale-[0.93] rounded-lg py-3 font-semibold text-base text-foreground transition-all"
				>+</button>
				<button
					type="button"
					id="numpad-confirm"
					class="col-span-3 bg-primary text-primary-foreground rounded-lg py-3 font-semibold text-sm hover:bg-primary/90"
				>確認</button>
			</div>
		</div>
	</form>
}

templ numpadKey(digit string) {
	<button
		type="button"
		data-numpad-key={ digit }
		class="bg-muted hover:bg-muted/70 active:scale-[0.93] rounded-lg h-12 text-base font-medium text-foreground transition-all"
	>{ digit }</button>
}

templ numpadKeyLabeled(digit string, label string) {
	<button
		type="button"
		data-numpad-key={ digit }
		aria-label={ label }
		class="bg-muted hover:bg-muted/70 active:scale-[0.93] rounded-lg h-12 text-base font-medium text-foreground transition-all"
	>{ digit }</button>
}

templ numpadKeyIcon(key string, label string) {
	<button
		type="button"
		data-numpad-key={ key }
		aria-label={ label }
		class="bg-muted hover:bg-muted/70 active:scale-[0.93] rounded-lg h-12 inline-flex items-center justify-center text-foreground transition-all"
	>
		<span aria-hidden="true" class="inline-flex">@icon.Delete(icon.Props{Size: 20})
</span>
	</button>
}
