package components

import (
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/alert"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/button"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/card"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/icon"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/skeleton"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/tabs"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/toast"
	"github.com/omegaatt36/noccounting/internal/app/webapp/components/utils"
)

templ Page(devMode bool) {
	<!DOCTYPE html>
	<html lang="zh-TW" data-theme="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<title>旅行記帳</title>
			<link rel="icon" href="data:,"/>
			<meta name="htmx-config" content={ `{"noSwap":[204,304,"4xx","5xx"]}` }/>
			<link rel="stylesheet" href={ "/static/output.css?v=" + utils.ScriptVersion }/>
			<script src="https://telegram.org/js/telegram-web-app.js"></script>
			<script src={ "/static/theme.js?v=" + utils.ScriptVersion }></script>
			<script src={ "/static/htmx.min.js?v=" + utils.ScriptVersion }></script>
			@tabs.Script()
			@toast.Script()
		</head>
		<body class="font-sans min-h-screen bg-background text-foreground">
			<div id="loading" class="flex flex-col items-center justify-center min-h-screen">
				<div class="max-w-md w-full px-4">
					@card.Card(card.Props{}) {
						@card.Content(card.ContentProps{}) {
							@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-48 mx-auto mb-6"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-12 w-full mb-4"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-12 w-full mb-4"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-10 w-full mb-4"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-10 w-full mb-4"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-14 w-full"})
						}
					}
				</div>
			</div>
			<div id="forbidden" class="hidden flex flex-col items-center justify-center min-h-screen">
				<div class="max-w-md w-full px-4">
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
						@alert.Title() {
							存取被拒絕 
						}
						@alert.Description() {
							你沒有權限使用此應用程式，請聯繫管理員 
						}
					}
				</div>
			</div>
			<div id="trip-error" class="hidden max-w-md mx-auto px-4 py-6 space-y-3">
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
					@alert.Title() {
						無法載入旅行 
					}
					@alert.Description() {
						網路或伺服器暫時有問題，請稍後再試 
					}
				}
				@button.Button(button.Props{Type: button.TypeButton, FullWidth: true, Attributes: templ.Attributes{"data-action": "reload"}}) {
					重試
				}
			</div>
			<div id="trip-empty" class="hidden max-w-md mx-auto px-4 py-6">
				@card.Card(card.Props{}) {
					@card.Content(card.ContentProps{}) {
						<div class="flex flex-col items-center gap-3 py-10 text-center">
							<span aria-hidden="true" class="inline-flex text-muted-foreground">@icon.Luggage(icon.Props{Size: 40})
</span>
							<p class="text-lg font-semibold">還沒有可用的旅行</p>
							<p class="text-sm text-muted-foreground">請先在 TREK 把記帳帳號加入旅行，完成後重新載入就會看到行程。</p>
							@button.Button(button.Props{Type: button.TypeButton, Class: "mt-2", Attributes: templ.Attributes{"data-action": "reload"}}) {
								重新載入
							}
						</div>
					}
				}
			</div>
			<main id="app" class="hidden max-w-md mx-auto px-4 py-6 pb-20">
				<div class="mb-3">
					<select
						id="trip-select"
						aria-label="選擇旅行"
						class="w-full px-3 py-2 rounded-md outline-none text-sm bg-input dark:bg-input/30 border border-input focus:ring-2 focus:ring-ring/50"
					></select>
				</div>
				<div id="view-form">
					@card.Card(card.Props{}) {
						@card.Content(card.ContentProps{}) {
							@ExpenseForm()
						}
					}
				</div>
				<div id="view-list" class="hidden">
					@card.Card(card.Props{}) {
						@card.Content(card.ContentProps{}) {
							@ListTab()
						}
					}
				</div>
				<div id="view-stats" class="hidden">
					@card.Card(card.Props{}) {
						@card.Content(card.ContentProps{}) {
							@StatsTab()
						}
					}
				</div>
				<div id="view-settle" class="hidden">
					@card.Card(card.Props{}) {
						@card.Content(card.ContentProps{}) {
							@SettlementTab()
						}
					}
				</div>
				<div id="result" class="fixed top-4 left-4 right-4 z-50" role="status" aria-live="polite"></div>
				@BottomNav()
			</main>
			@initScript(devMode)
		</body>
	</html>
}

templ initScript(devMode bool) {
	if devMode {
		<div id="dev-mode-flag" data-enabled="true" style="display:none;"></div>
	}
	<script type="module" src={ "/static/app.js?v=" + utils.ScriptVersion }></script>
}
