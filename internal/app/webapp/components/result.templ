package components

import "github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/toast"

// Result is the toast the form shows after saving an expense: what was saved
// when it was, what could not be saved and why when it was not.
templ Result(success bool, title string, description string) {
	if success {
		@toast.Toast(toast.Props{
			Title:       title,
			Description: description,
			Variant:     toast.VariantSuccess,
			Position:    toast.PositionTopCenter,
			Duration:    3000,
			Dismissible: true,
		})
	} else {
		@toast.Toast(toast.Props{
			Title:       title,
			Description: errorOrDefault(description),
			Variant:     toast.VariantError,
			Position:    toast.PositionTopCenter,
			Duration:    5000,
			Dismissible: true,
		})
	}
	<div
		id="toast-trigger"
		if success {
			data-success="true"
		} else {
			data-success="false"
		}
		style="display:none;"
	></div>
}

func errorOrDefault(msg string) string {
	if msg == "" {
		return "發生未知錯誤"
	}
	return msg
}
