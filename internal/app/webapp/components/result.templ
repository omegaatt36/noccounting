package components

import "github.com/omegaatt36/noccounting/internal/app/webapp/components/ui/toast"

templ Result(success bool, title string, description string) {
	if success {
		@toast.Toast(toast.Props{
			Title:       title,
			Description: description,
			Type:        toast.TypeSuccess,
			Timeout:    3000,
		})
	} else {
		@toast.Toast(toast.Props{
			Title:       title,
			Description: errorOrDefault(description),
			Type:        toast.TypeError,
			Timeout:    5000,
		})
	}
	<div
		id="toast-trigger"
		if success {
			data-success="true"
		} else {
			data-success="false"
		}
		style="display:none;"
	></div>
}

func errorOrDefault(msg string) string {
	if msg == "" {
		return "發生未知錯誤"
	}
	return msg
}
